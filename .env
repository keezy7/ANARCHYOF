# Variáveis de ambiente da Anarchy (com funcionalidades do Pelegram)
# Banco de dados: SQLite (arquivo local anarchy.db) - não precisa de PostgreSQL

# Porta da aplicação
PORT=3000

# Chave secreta para JWT (altere em produção!)
JWT_SECRET=anarchy-archives-2026-segredo-secreto-alterado

# Ambiente (deixe em production no host)
NODE_ENV=production
